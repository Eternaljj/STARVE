{
  "config_version": "h1-openai-compatible-experiment-v1",
  "protocol_id": "formal_H1_multitask_v3_2_openai_compatible_v1",
  "base_protocol_manifest": "formal_H1_multitask_v3_2_freeze_manifest.json",
  "base_protocol_markdown": "formal_H1_multitask_v3_2.md",
  "independent_freeze_record": "formal_H1_multitask_v3_2_openai_compatible_v1_freeze_record.json",
  "output_prefix": "formal_H1_multitask_v3_2_openai_compatible_",
  "provider": {
    "interface": "openai-compatible-chat-completions-v1",
    "endpoint_path": "/chat/completions",
    "legacy_defaults": {
      "base_url": "https://api.siliconflow.cn/v1",
      "model_id": "deepseek-ai/DeepSeek-V3.2"
    },
    "environment": {
      "base_url": "H1_API_BASE_URL",
      "api_key": "H1_API_KEY",
      "model_id": "H1_MODEL_ID"
    },
    "sampling": {
      "temperature": 0.0,
      "max_output_tokens": 2400,
      "timeout_seconds": 180,
      "tool_choice": "auto",
      "parallel_tool_calls": false,
      "stream": false
    }
  },
  "scope": {
    "changes_provider_identity_only": true,
    "changes_h1_experiment_logic": false,
    "allows_historical_result_overwrite": false,
    "allows_pooling_with_frozen_model_results_without_new_protocol": false
  },
  "independent_freeze_scope": {
    "inherit_base_h1_inventory": true,
    "excluded_paths": {
      "run_h2.py": "Independent H2 entry point; not present in the static H1 import closure."
    },
    "integrity_method": "version, size, timestamp, permissions, and modification record"
  }
}
