    "candidate_handling": "Every saved candidate remains in its frozen source record. This replay creates no replacement plan and never writes to the source result.",
    "rule_order": [
      {
        "when": "candidate is not parse-valid or not hard-task-valid",
        "disposition": "REJECT_HARD_INVALID",
        "retained_plan": "predecessor",
        "residual_gap_status": "not_evaluable"
      },
      {
        "when": "candidate is hard-task-valid and any frozen refinement status rank is lower than its predecessor",
        "disposition": "REJECT_REFINEMENT_REGRESSION",
        "retained_plan": "predecessor"
      },
      {
        "when": "candidate is hard-task-valid and has no frozen refinement-status regression",
        "disposition": "ACCEPT_NONREGRESSING_HARD_VALID",
        "retained_plan": "candidate"
      }
    ],
    "measurement_boundary": "Acceptance does not require a substantive refinement event. Rejected candidates do not count toward revision depth."
  },
